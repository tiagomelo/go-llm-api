{
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "swagger": "2.0",
  "info": {
    "description": "A sample RESTful API for interacting with large language models.",
    "title": "Go LLM API",
    "contact": {
      "name": "Tiago Melo",
      "email": "tiagoharris@gmail.com"
    },
    "version": "0.0.1"
  },
  "paths": {
    "/api/v1/generate": {
      "post": {
        "tags": [
          "generate"
        ],
        "summary": "Generate text based on the provided model, prompt, and context.",
        "operationId": "Generate",
        "parameters": [
          {
            "name": "Body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/GenerateRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/responses/generateResponse"
          },
          "400": {
            "description": " bad request"
          },
          "500": {
            "description": " internal server error"
          }
        }
      }
    },
    "/api/v1/generate/stream": {
      "post": {
        "description": "Each event is formatted as:\n\n`data: {\"response\":\"token\",\"done\":false}`\n\nFinal event:\n\n`event: done`\n`data: {\"done\":true}`",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "text/event-stream"
        ],
        "tags": [
          "generate"
        ],
        "summary": "Stream generated text using Server-Sent Events (SSE).",
        "operationId": "GenerateStream",
        "parameters": [
          {
            "name": "Body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/GenerateRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": " SSE stream of generated tokens"
          },
          "400": {
            "description": " bad request"
          },
          "500": {
            "description": " internal server error"
          }
        }
      }
    },
    "/api/v1/models": {
      "get": {
        "tags": [
          "models"
        ],
        "summary": "Get all available models.",
        "operationId": "GetModels",
        "responses": {
          "200": {
            "$ref": "#/responses/getModelsResponse"
          },
          "500": {
            "description": " internal server error"
          }
        }
      }
    }
  },
